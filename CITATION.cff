    given-names: "Sevda"
  - family-names: "Hasanaj"
    given-names: "Polikseni"
  - family-names: "Afsharzadehtorghab"
    given-names: "Saba"
  - family-names: "Briccolani"
    given-names: "Claudia"
repository-code: "https://github.com/callmesevda/KR-Project"
license: CC-BY-4.0
keywords:
  - ontology
  - OWL
  - proverbs
  - tacit knowledge
  - cross-cultural equivalence
  - knowledge representation
