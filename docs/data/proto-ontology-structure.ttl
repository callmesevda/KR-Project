@prefix : <https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .

<https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl> rdf:type owl:Ontology ;
    rdfs:label "PROTO — Proverbs & Tacit-knowledge Ontology" ;
    rdfs:comment "Models proverbs, their unspoken lessons, the situations they're used in, and cross-cultural equivalences between proverbs that share a lesson but diverge in imagery." .

#################################################################
#    Classes
#################################################################

:Proverb rdf:type owl:Class ;
    rdfs:label "Proverb" ;
    rdfs:comment "The surface expression of a proverb: its literal text, language, and image/source domain." .

:TacitLesson rdf:type owl:Class ;
    rdfs:label "Tacit Lesson" ;
    rdfs:comment "The unspoken, language-independent moral a proverb conveys." .

:SituationOfUse rdf:type owl:Class ;
    rdfs:label "Situation of Use" ;
    rdfs:comment "The pragmatic context in which a proverb would be deployed." .

:SourceDomain rdf:type owl:Class ;
    rdfs:label "Source Domain" ;
    rdfs:comment "The literal imagery/domain a proverb draws on (e.g. birds, fish, sleep, food)." .

:CrossCulturalEquivalence rdf:type owl:Class ;
    rdfs:label "Cross-Cultural Equivalence" ;
    rdfs:comment "A reified link between two proverbs that share a TacitLesson but diverge (or don't) in imagery. Modeled as a full class so the equivalence itself can carry attributes (type, divergence notes, annotator)." .

# Controlled vocabulary for equivalence type
:EquivalenceType rdf:type owl:Class ;
    rdfs:label "Equivalence Type" .

:SameLessonDifferentImage rdf:type owl:NamedIndividual , :EquivalenceType ;
    rdfs:label "Same lesson, different image" .

:FalseFriend rdf:type owl:NamedIndividual , :EquivalenceType ;
    rdfs:label "False friend (same image, different lesson)" .

:PartialOverlap rdf:type owl:NamedIndividual , :EquivalenceType ;
    rdfs:label "Partial overlap" .

:DirectMatch rdf:type owl:NamedIndividual , :EquivalenceType ;
    rdfs:label "Direct match (same lesson AND same source domain)" ;
    rdfs:comment "For pairs that share both lesson and imagery across languages, e.g. two cultures both using 'a chain is only as strong as its weakest link.' Stronger than SameLessonDifferentImage; not covered by the original three types." .

#################################################################
#    Object Properties
#################################################################

:hasLesson rdf:type owl:ObjectProperty ;
    rdfs:domain :Proverb ;
    rdfs:range :TacitLesson ;
    rdfs:label "has lesson" .

:hasSourceDomain rdf:type owl:ObjectProperty ;
    rdfs:domain :Proverb ;
    rdfs:range :SourceDomain ;
    rdfs:label "has source domain" .

:usedIn rdf:type owl:ObjectProperty ;
    rdfs:domain :Proverb ;
    rdfs:range :SituationOfUse ;
    rdfs:label "used in" .

:linksProverbA rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :CrossCulturalEquivalence ;
    rdfs:range :Proverb ;
    rdfs:label "links proverb A" ;
    rdfs:comment "Functional: one equivalence link points to exactly one proverb as its 'A' side." .

:linksProverbB rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :CrossCulturalEquivalence ;
    rdfs:range :Proverb ;
    rdfs:label "links proverb B" ;
    rdfs:comment "Functional: one equivalence link points to exactly one proverb as its 'B' side." .

:hasEquivalenceType rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :CrossCulturalEquivalence ;
    rdfs:range :EquivalenceType ;
    rdfs:label "has equivalence type" ;
    rdfs:comment "Functional: one equivalence link has exactly one equivalence type. Combined with the AllDifferent axiom on the four types below, this is what lets the reasoner catch a link accidentally assigned two different types." .

:groundedIn rdf:type owl:ObjectProperty ;
    rdfs:domain [ rdf:type owl:Class ; owl:unionOf ( :TacitLesson :SourceDomain ) ] ;
    rdfs:comment "Links a TacitLesson or SourceDomain to its grounding concept in Wikidata (range is external, e.g. wd:Q...). Matches the spreadsheet's 'Tacit Lesson URI' and 'Literal Image URI' columns. No rdfs:range is declared deliberately: the value is a Wikidata entity outside this ontology's own classes, so constraining it to one of our classes would be incorrect. This omission is intentional, not an oversight." ;
    rdfs:label "grounded in (Wikidata)" .

#################################################################
#    Data Properties
#################################################################

:hasText rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Proverb ;
    rdfs:range xsd:string ;
    rdfs:label "has text" ;
    rdfs:comment "Functional: one proverb has exactly one literal text." .

:hasTranslation rdf:type owl:DatatypeProperty ;
    rdfs:domain :Proverb ;
    rdfs:range xsd:string ;
    rdfs:label "has literal English translation" ;
    rdfs:comment "Word-for-word English gloss, distinct from hasText (the proverb in its original language)." .

:hasProverbID rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Proverb ;
    rdfs:range xsd:string ;
    rdfs:label "has proverb ID" ;
    rdfs:comment "Stable human-readable ID from the shared spreadsheet, e.g. PRV-001. Used as a key when generating URIs. Functional: one proverb has exactly one ID." .

:hasLanguage rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Proverb ;
    rdfs:range xsd:string ;
    rdfs:label "has language" ;
    rdfs:comment "Functional: one proverb individual is recorded in exactly one language." .

:hasLabel rdf:type owl:DatatypeProperty ;
    rdfs:domain :TacitLesson ;
    rdfs:range xsd:string ;
    rdfs:label "has label" .

:hasDivergenceNote rdf:type owl:DatatypeProperty ;
    rdfs:domain :CrossCulturalEquivalence ;
    rdfs:range xsd:string ;
    rdfs:label "has divergence note" .

:annotatedBy rdf:type owl:DatatypeProperty ;
    rdfs:domain :CrossCulturalEquivalence ;
    rdfs:range xsd:string ;
    rdfs:label "annotated by" .

#################################################################
#    Disjointness and Restrictions (Professor's Point 5)
#################################################################
#
# Goal: when bad data enters the graph, the reasoner (HermiT) must be
# able to catch it. Everything below is a consistency check, not new
# vocabulary - no new classes or properties are introduced here.

# --- 1. The six classes are pairwise disjoint ---
# No individual can be, say, both a Proverb and a TacitLesson at once.
# Catches the test case: "a proverb typed also as a TacitLesson".
[] rdf:type owl:AllDisjointClasses ;
    owl:members ( :Proverb :TacitLesson :SituationOfUse :SourceDomain :CrossCulturalEquivalence :EquivalenceType ) .

# --- 2. EquivalenceType is a closed list of exactly these four individuals ---
# Nobody can introduce a fifth, unlisted equivalence type by accident;
# the reasoner will flag any individual claimed to be an EquivalenceType
# that isn't one of these four.
:EquivalenceType owl:equivalentClass [
    rdf:type owl:Class ;
    owl:oneOf ( :DirectMatch :SameLessonDifferentImage :PartialOverlap :FalseFriend )
] .

# The four types are also explicitly asserted distinct from each other.
# Combined with hasEquivalenceType being functional (see above), this is
# what catches the test case: "a link with two different equivalence types".
[] rdf:type owl:AllDifferent ;
    owl:distinctMembers ( :DirectMatch :SameLessonDifferentImage :PartialOverlap :FalseFriend ) .

# --- 3. Functional properties ---
# hasProverbID, hasLanguage, hasText, linksProverbA, linksProverbB and
# hasEquivalenceType are declared owl:FunctionalProperty directly on
# their own definitions above (each can point to at most one value).

# --- 4. Class restrictions on Proverb ---
# Every Proverb individual must have exactly one lesson, at least one
# source domain, and at least one situation of use. "exactly 1" is a
# qualified cardinality restriction; "some" is an existential restriction
# (at least one, no upper limit, since a proverb could plausibly fit more
# than one situation).
:Proverb rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :hasLesson ;
      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onClass :TacitLesson ] ,
    [ rdf:type owl:Restriction ;
      owl:onProperty :hasSourceDomain ;
      owl:someValuesFrom :SourceDomain ] ,
    [ rdf:type owl:Restriction ;
      owl:onProperty :usedIn ;
      owl:someValuesFrom :SituationOfUse ] .

# --- 5. Class restrictions on CrossCulturalEquivalence ---
# Every equivalence individual must have exactly one proverb on each side
# and exactly one equivalence type - this is what makes it a well-formed
# reified link rather than a dangling or ambiguous one.
:CrossCulturalEquivalence rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :linksProverbA ;
      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onClass :Proverb ] ,
    [ rdf:type owl:Restriction ;
      owl:onProperty :linksProverbB ;
      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onClass :Proverb ] ,
    [ rdf:type owl:Restriction ;
      owl:onProperty :hasEquivalenceType ;
      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onClass :EquivalenceType ] .

# NOTE on open-world assumption: OWL does not flag a MISSING value - e.g.
# a Proverb individual with no hasLesson triple at all will NOT trigger
# an inconsistency, because OWL assumes unstated facts might still be
# true elsewhere, not false. These restrictions only catch WRONG values
# (a lesson of the wrong type, two conflicting equivalence types, etc.),
# not ABSENT ones. Missing-value checks belong in Polyxeni's SPARQL
# queries, not in these OWL axioms. State this plainly in the
# documentation so nobody expects the reasoner to catch incomplete data.
