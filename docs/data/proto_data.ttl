:PRV-004 a owl:NamedIndividual,
        proto:Proverb ;
    proto:hasLanguage "fa" ;
    proto:hasLesson :OptimismInAdversity ;
    proto:hasProverbID "PRV-004" ;
    proto:hasSourceDomain :Night,
        :White ;
    proto:hasText "پایان شب سیه سپید است" ;
    proto:hasTranslation "The end of the black night is white" ;
    proto:usedIn :Situation_PRV-004 .

:PRV-005 a owl:NamedIndividual,
        proto:Proverb ;
    proto:hasLanguage "fa" ;
    proto:hasLesson :OptimismInAdversity ;
    proto:hasProverbID "PRV-005" ;
    proto:hasSourceDomain :Despair,
        :Hope ;
    proto:hasText "در ناامیدی بسی امید است" ;
    proto:hasTranslation "In despair there is much hope" ;
    proto:usedIn :Situation_PRV-005 .

:PRV-008 a owl:NamedIndividual,
        proto:Proverb ;
    proto:hasLanguage "en" ;
    proto:hasLesson :HiddenDepthsDeceptiveAppearances ;
    proto:hasProverbID "PRV-008" ;
    proto:hasSourceDomain :Depth,
        :Water ;
    proto:hasText "Still waters run deep." ;
    proto:hasTranslation "Still waters run deep." ;
    proto:usedIn :Situation_PRV-008 .

:PRV-009 a owl:NamedIndividual,
        proto:Proverb ;
    proto:hasLanguage "fa" ;
    proto:hasLesson :HiddenDepthsDeceptiveAppearances ;
    proto:hasProverbID "PRV-009" ;
    proto:hasSourceDomain :Noise,
        :Posture ;
    proto:hasText "از آن نترس که های و هو دارد، از آن بترس که سر به تو دارد" ;
    proto:hasTranslation "Don't fear the one who makes noise, fear the one who keeps their head down." ;
    proto:usedIn :Situation_PRV-009 .

:PRV-012 a owl:NamedIndividual,
        proto:Proverb ;
    proto:hasLanguage "en" ;
    proto:hasLesson :GroupVulnerability ;
    proto:hasProverbID "PRV-012" ;
    proto:hasSourceDomain :Chain,
        :Link ;
    proto:hasText "A chain is only as strong as its weakest link." ;
    proto:hasTranslation "A chain is only as strong as its weakest link." ;
    proto:usedIn :Situation_PRV-012 .

:PRV-013 a owl:NamedIndividual,
        proto:Proverb ;
