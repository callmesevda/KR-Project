    proto:hasLesson :GroupVulnerability ;
    proto:hasProverbID "PRV-013" ;
    proto:hasSourceDomain :Crack,
        :Wall ;
    proto:hasText "دیوار از جای شکسته می‌ریزد" ;
    proto:hasTranslation "A wall collapses from its broken part" ;
