        :Water ;
    proto:hasText "L'acqua cheta rovina i ponti." ;
    proto:hasTranslation "Still waters ruins bridges." ;
    proto:usedIn :Situation_PRV-021 .

:PRV-025 a owl:NamedIndividual,
        proto:Proverb ;
