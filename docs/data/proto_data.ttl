    proto:hasText "La catena si spezza sempre nel punto più debole" ;
    proto:hasTranslation "A chain breaks always in its weakest spot." ;
    proto:usedIn :Situation_PRV-025 .

:PRV-027 a owl:NamedIndividual,
        proto:Proverb ;
    proto:hasLanguage "sq" ;
    proto:hasLesson :ActionsOverIntentions ;
    proto:hasProverbID "PRV-027" ;
    proto:hasSourceDomain :Cloud,
        :Deed,
        :Rain ;
    proto:hasText "Fjala pa vepër, si reja pa shi." ;
    proto:hasTranslation "A word without a deed is like a cloud without rain." ;
    proto:usedIn :Situation_PRV-027 .

:PRV-028 a owl:NamedIndividual,
        proto:Proverb ;
    proto:hasLanguage "sq" ;
    proto:hasLesson :ActionsOverIntentions ;
    proto:hasProverbID "PRV-028" ;
    proto:hasSourceDomain :Enemy,
        :Friend ;
    proto:hasText "Më mirë armik i mençur se mik budalla." ;
    proto:hasTranslation "Better a wise enemy than a foolish friend." ;
    proto:usedIn :Situation_PRV-028 .

:PRV-029 a owl:NamedIndividual,
