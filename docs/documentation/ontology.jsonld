  } ]
}, {
  "@id" : "https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl#hasProverbID",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Stable human-readable ID from the shared spreadsheet, e.g. PRV-001. Used as a key when generating URIs. Functional: one proverb has exactly one ID."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl#Proverb"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has proverb ID"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "http://www.w3.org/2004/02/skos/core#example" : [ {
    "@value" : "PRV-001"
  } ]
}, {
  "@id" : "https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl#hasSourceDomain",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Links a proverb to an image or domain its literal wording draws on; a proverb can have several."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl#Proverb"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has source domain"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl#SourceDomain"
  } ],
  "http://www.w3.org/2004/02/skos/core#example" : [ {
    "@value" : "PRV-012 has source domains Chain and Link"
  } ]
}, {
  "@id" : "https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl#hasText",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The proverb as written in its original language and script. Functional: one proverb has exactly one literal text."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl#Proverb"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has text"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "http://www.w3.org/2004/02/skos/core#example" : [ {
    "@value" : "PRV-020 has text 'Chi cerca, trova.'"
  } ]
}, {
  "@id" : "https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl#hasTranslation",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Word-for-word English gloss, distinct from hasText (the proverb in its original language)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl#Proverb"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has literal English translation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "http://www.w3.org/2004/02/skos/core#example" : [ {
    "@value" : "PRV-020 has translation 'Those who search, find.'"
  } ]
}, {
  "@id" : "https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl#linksProverbA",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Links a cross-cultural equivalence to the first of the two proverbs it connects; the generated data puts the lower proverb ID here, and the order carries no meaning. Functional: one equivalence link points to exactly one proverb as its 'A' side."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl#CrossCulturalEquivalence"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "links proverb A"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl#Proverb"
  } ],
  "http://www.w3.org/2004/02/skos/core#example" : [ {
    "@value" : "Equiv_PRV-012_PRV-025 links proverb A PRV-012"
  } ]
}, {
  "@id" : "https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl#linksProverbB",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Links a cross-cultural equivalence to the second of the two proverbs it connects, which is in a different language from proverb A. Functional: one equivalence link points to exactly one proverb as its 'B' side."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl#CrossCulturalEquivalence"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "links proverb B"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl#Proverb"
  } ],
  "http://www.w3.org/2004/02/skos/core#example" : [ {
    "@value" : "Equiv_PRV-012_PRV-025 links proverb B PRV-025"
  } ]
}, {
  "@id" : "https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl#usedIn",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Links a proverb to a situation in which it is typically used."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl#Proverb"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "used in"
