<?xml version="1.0"?>
<rdf:RDF xmlns="https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl#"
     xml:base="https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl">
        <owl:versionIRI rdf:resource="https://raw.githubusercontent.com/callmesevda/KR-Project/v1.1.0/proto-ontology-structure.ttl"/>
        <terms:abstract xml:lang="en">PROTO models proverbs, the tacit (unspoken) lessons they carry, the situations in which they are used, and the cross-cultural equivalences that link a proverb in one language to a proverb in another when they teach the same lesson but diverge (or don&apos;t) in imagery. The current dataset covers 28 proverbs across four languages (English, Farsi, Italian, and Albanian), grounded in Wikidata for their tacit lessons and source-domain imagery.</terms:abstract>
        <terms:bibliographicCitation>Rezaei Melal, S., Chasanai, P., Afsharzadehtorghab, S., and Briccolani, C. (2026). PROTO — Proverbs &amp; Tacit-knowledge Ontology, version 1.1.0. https://github.com/callmesevda/KR-Project</terms:bibliographicCitation>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-10</terms:created>
        <terms:creator>Claudia Briccolani</terms:creator>
        <terms:creator>Polyxeni Chasanai</terms:creator>
        <terms:creator>Saba Afsharzadehtorghab</terms:creator>
        <terms:creator>Sevda Rezaei Melal</terms:creator>
        <terms:description xml:lang="en">Models proverbs, their unspoken lessons, the situations they&apos;re used in, and cross-cultural equivalences between proverbs that share a lesson but diverge in imagery.</terms:description>
        <terms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-09</terms:issued>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-09</terms:modified>
        <terms:title xml:lang="en">PROTO — Proverbs &amp; Tacit-knowledge Ontology</terms:title>
        <vann:preferredNamespacePrefix>proto</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl#</vann:preferredNamespaceUri>
        <rdfs:comment xml:lang="en">Models proverbs, their unspoken lessons, the situations they&apos;re used in, and cross-cultural equivalences between proverbs that share a lesson but diverge in imagery.</rdfs:comment>
        <rdfs:label xml:lang="en">PROTO — Proverbs &amp; Tacit-knowledge Ontology</rdfs:label>
        <owl:versionInfo>1.1.0</owl:versionInfo>
    </owl:Ontology>
    


