<?xml version="1.0"?>
<rdf:RDF xmlns="http://example.org/proto#"
     xml:base="http://example.org/proto"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology rdf:about="http://example.org/proto">
        <rdfs:comment>Models proverbs, their unspoken lessons, the situations they&apos;re used in, and cross-cultural equivalences between proverbs that share a lesson but diverge in imagery.</rdfs:comment>
        <rdfs:label>PROTO — Proverbs &amp; Tacit-knowledge Ontology</rdfs:label>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://example.org/proto#groundedIn -->


    <owl:ObjectProperty rdf:about="http://example.org/proto#groundedIn">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.org/proto#SourceDomain"/>
                    <rdf:Description rdf:about="http://example.org/proto#TacitLesson"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:comment>Links a TacitLesson or SourceDomain to its grounding concept in Wikidata (range is external, e.g. wd:Q...). Matches the spreadsheet&apos;s &apos;Tacit Lesson URI&apos; and &apos;Literal Image URI&apos; columns.</rdfs:comment>
        <rdfs:label>grounded in (Wikidata)</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/proto#hasEquivalenceType -->


    <owl:ObjectProperty rdf:about="http://example.org/proto#hasEquivalenceType">
        <rdfs:domain rdf:resource="http://example.org/proto#CrossCulturalEquivalence"/>
        <rdfs:range rdf:resource="http://example.org/proto#EquivalenceType"/>
        <rdfs:label>has equivalence type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/proto#hasLesson -->


    <owl:ObjectProperty rdf:about="http://example.org/proto#hasLesson">
        <rdfs:domain rdf:resource="http://example.org/proto#Proverb"/>
        <rdfs:range rdf:resource="http://example.org/proto#TacitLesson"/>
        <rdfs:label>has lesson</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/proto#hasSourceDomain -->


    <owl:ObjectProperty rdf:about="http://example.org/proto#hasSourceDomain">
        <rdfs:domain rdf:resource="http://example.org/proto#Proverb"/>
        <rdfs:range rdf:resource="http://example.org/proto#SourceDomain"/>
        <rdfs:label>has source domain</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/proto#linksProverbA -->


    <owl:ObjectProperty rdf:about="http://example.org/proto#linksProverbA">
        <rdfs:domain rdf:resource="http://example.org/proto#CrossCulturalEquivalence"/>
        <rdfs:range rdf:resource="http://example.org/proto#Proverb"/>
        <rdfs:label>links proverb A</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/proto#linksProverbB -->


    <owl:ObjectProperty rdf:about="http://example.org/proto#linksProverbB">
        <rdfs:domain rdf:resource="http://example.org/proto#CrossCulturalEquivalence"/>
        <rdfs:range rdf:resource="http://example.org/proto#Proverb"/>
        <rdfs:label>links proverb B</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/proto#usedIn -->


    <owl:ObjectProperty rdf:about="http://example.org/proto#usedIn">
        <rdfs:domain rdf:resource="http://example.org/proto#Proverb"/>
        <rdfs:range rdf:resource="http://example.org/proto#SituationOfUse"/>
        <rdfs:label>used in</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://example.org/proto#annotatedBy -->


    <owl:DatatypeProperty rdf:about="http://example.org/proto#annotatedBy">
        <rdfs:domain rdf:resource="http://example.org/proto#CrossCulturalEquivalence"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>annotated by</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/proto#hasDivergenceNote -->


    <owl:DatatypeProperty rdf:about="http://example.org/proto#hasDivergenceNote">
        <rdfs:domain rdf:resource="http://example.org/proto#CrossCulturalEquivalence"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>has divergence note</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/proto#hasLabel -->


    <owl:DatatypeProperty rdf:about="http://example.org/proto#hasLabel">
        <rdfs:domain rdf:resource="http://example.org/proto#TacitLesson"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>has label</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/proto#hasLanguage -->


    <owl:DatatypeProperty rdf:about="http://example.org/proto#hasLanguage">
        <rdfs:domain rdf:resource="http://example.org/proto#Proverb"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>has language</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/proto#hasProverbID -->


    <owl:DatatypeProperty rdf:about="http://example.org/proto#hasProverbID">
        <rdfs:domain rdf:resource="http://example.org/proto#Proverb"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Stable human-readable ID from the shared spreadsheet, e.g. PRV-001. Used as a key when generating URIs.</rdfs:comment>
        <rdfs:label>has proverb ID</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/proto#hasText -->


    <owl:DatatypeProperty rdf:about="http://example.org/proto#hasText">
        <rdfs:domain rdf:resource="http://example.org/proto#Proverb"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>has text</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/proto#hasTranslation -->


    <owl:DatatypeProperty rdf:about="http://example.org/proto#hasTranslation">
        <rdfs:domain rdf:resource="http://example.org/proto#Proverb"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Word-for-word English gloss, distinct from hasText (the proverb in its original language).</rdfs:comment>
        <rdfs:label>has literal English translation</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://example.org/proto#CrossCulturalEquivalence -->


    <owl:Class rdf:about="http://example.org/proto#CrossCulturalEquivalence">
        <rdfs:comment>A reified link between two proverbs that share a TacitLesson but diverge (or don&apos;t) in imagery. Modeled as a full class so the equivalence itself can carry attributes (type, divergence notes, annotator).</rdfs:comment>
        <rdfs:label>Cross-Cultural Equivalence</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/proto#EquivalenceType -->


    <owl:Class rdf:about="http://example.org/proto#EquivalenceType">
        <rdfs:label>Equivalence Type</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/proto#Proverb -->


    <owl:Class rdf:about="http://example.org/proto#Proverb">
        <rdfs:comment>The surface expression of a proverb: its literal text, language, and image/source domain.</rdfs:comment>
        <rdfs:label>Proverb</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/proto#SituationOfUse -->


    <owl:Class rdf:about="http://example.org/proto#SituationOfUse">
        <rdfs:comment>The pragmatic context in which a proverb would be deployed.</rdfs:comment>
        <rdfs:label>Situation of Use</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/proto#SourceDomain -->


    <owl:Class rdf:about="http://example.org/proto#SourceDomain">
        <rdfs:comment>The literal imagery/domain a proverb draws on (e.g. birds, fish, sleep, food).</rdfs:comment>
        <rdfs:label>Source Domain</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/proto#TacitLesson -->


    <owl:Class rdf:about="http://example.org/proto#TacitLesson">
        <rdfs:comment>The unspoken, language-independent moral a proverb conveys.</rdfs:comment>
        <rdfs:label>Tacit Lesson</rdfs:label>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://example.org/proto#DirectMatch -->


    <owl:NamedIndividual rdf:about="http://example.org/proto#DirectMatch">
        <rdf:type rdf:resource="http://example.org/proto#EquivalenceType"/>
        <rdfs:comment>For pairs that share both lesson and imagery across languages, e.g. two cultures both using &apos;a chain is only as strong as its weakest link.&apos; Stronger than SameLessonDifferentImage; not covered by the original three types.</rdfs:comment>
        <rdfs:label>Direct match (same lesson AND same source domain)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://example.org/proto#FalseFriend -->


    <owl:NamedIndividual rdf:about="http://example.org/proto#FalseFriend">
        <rdf:type rdf:resource="http://example.org/proto#EquivalenceType"/>
        <rdfs:label>False friend (same image, different lesson)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://example.org/proto#PartialOverlap -->


    <owl:NamedIndividual rdf:about="http://example.org/proto#PartialOverlap">
        <rdf:type rdf:resource="http://example.org/proto#EquivalenceType"/>
        <rdfs:label>Partial overlap</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://example.org/proto#SameLessonDifferentImage -->


    <owl:NamedIndividual rdf:about="http://example.org/proto#SameLessonDifferentImage">
        <rdf:type rdf:resource="http://example.org/proto#EquivalenceType"/>
        <rdfs:label>Same lesson, different image</rdfs:label>
    </owl:NamedIndividual>
</rdf:RDF>



