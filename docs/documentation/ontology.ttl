@prefix : <https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl#> .

<https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl> rdf:type owl:Ontology ;
                                                                                              owl:versionIRI <https://raw.githubusercontent.com/callmesevda/KR-Project/v1.1.0/proto-ontology-structure.ttl> ;
                                                                                              <http://purl.org/dc/terms/abstract> "PROTO models proverbs, the tacit (unspoken) lessons they carry, the situations in which they are used, and the cross-cultural equivalences that link a proverb in one language to a proverb in another when they teach the same lesson but diverge (or don't) in imagery. The current dataset covers 28 proverbs across four languages (English, Farsi, Italian, and Albanian), grounded in Wikidata for their tacit lessons and source-domain imagery."@en ;
                                                                                              <http://purl.org/dc/terms/bibliographicCitation> "Rezaei Melal, S., Chasanai, P., Afsharzadehtorghab, S., and Briccolani, C. (2026). PROTO — Proverbs & Tacit-knowledge Ontology, version 1.1.0. https://github.com/callmesevda/KR-Project" ;
                                                                                              <http://purl.org/dc/terms/created> "2026-09-10"^^xsd:date ;
                                                                                              <http://purl.org/dc/terms/creator> "Claudia Briccolani" ,
                                                                                                                                 "Polyxeni Chasanai" ,
                                                                                                                                 "Saba Afsharzadehtorghab" ,
                                                                                                                                 "Sevda Rezaei Melal" ;
                                                                                              <http://purl.org/dc/terms/description> "Models proverbs, their unspoken lessons, the situations they're used in, and cross-cultural equivalences between proverbs that share a lesson but diverge in imagery."@en ;
                                                                                              <http://purl.org/dc/terms/issued> "2026-10-09"^^xsd:date ;
                                                                                              <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
                                                                                              <http://purl.org/dc/terms/modified> "2026-10-09"^^xsd:date ;
                                                                                              <http://purl.org/dc/terms/title> "PROTO — Proverbs & Tacit-knowledge Ontology"@en ;
                                                                                              <http://purl.org/vocab/vann/preferredNamespacePrefix> "proto" ;
                                                                                              <http://purl.org/vocab/vann/preferredNamespaceUri> "https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl#" ;
                                                                                              rdfs:comment "Models proverbs, their unspoken lessons, the situations they're used in, and cross-cultural equivalences between proverbs that share a lesson but diverge in imagery."@en ;
                                                                                              rdfs:label "PROTO — Proverbs & Tacit-knowledge Ontology"@en ;
                                                                                              owl:versionInfo "1.1.0" .

