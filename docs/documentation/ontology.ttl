#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl#groundedIn
:groundedIn rdf:type owl:ObjectProperty ;
            rdfs:domain [ rdf:type owl:Class ;
                          owl:unionOf ( :SourceDomain
                                        :TacitLesson
                                      )
                        ] ;
            rdfs:comment "Links a TacitLesson or SourceDomain to its grounding concept in Wikidata (range is external, e.g. wd:Q...). Matches the spreadsheet's 'Tacit Lesson URI' and 'Literal Image URI' columns. No rdfs:range is declared deliberately: the value is a Wikidata entity outside this ontology's own classes, so constraining it to one of our classes would be incorrect. This omission is intentional, not an oversight."@en ;
            rdfs:isDefinedBy <https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl> ;
            rdfs:label "grounded in (Wikidata)"@en ;
            <http://www.w3.org/2004/02/skos/core#example> "Bear grounded in wd:Q30090244" .


###  https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl#hasEquivalenceType
:hasEquivalenceType rdf:type owl:ObjectProperty ,
                             owl:FunctionalProperty ;
                    rdfs:domain :CrossCulturalEquivalence ;
                    rdfs:range :EquivalenceType ;
                    rdfs:comment "Classifies a cross-cultural equivalence with one of the four equivalence types. Functional: one equivalence link has exactly one equivalence type. Combined with the AllDifferent axiom on the four types below, this is what lets the reasoner catch a link accidentally assigned two different types."@en ;
                    rdfs:isDefinedBy <https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl> ;
                    rdfs:label "has equivalence type"@en ;
                    <http://www.w3.org/2004/02/skos/core#example> "Equiv_PRV-012_PRV-025 has equivalence type DirectMatch" .


###  https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl#hasLesson
:hasLesson rdf:type owl:ObjectProperty ;
           rdfs:domain :Proverb ;
           rdfs:range :TacitLesson ;
           rdfs:comment "Links a proverb to the tacit lesson it conveys."@en ;
           rdfs:isDefinedBy <https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl> ;
           rdfs:label "has lesson"@en ;
           <http://www.w3.org/2004/02/skos/core#example> "PRV-012 has lesson GroupVulnerability" .


###  https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl#hasSourceDomain
:hasSourceDomain rdf:type owl:ObjectProperty ;
                 rdfs:domain :Proverb ;
                 rdfs:range :SourceDomain ;
                 rdfs:comment "Links a proverb to an image or domain its literal wording draws on; a proverb can have several."@en ;
                 rdfs:isDefinedBy <https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl> ;
                 rdfs:label "has source domain"@en ;
                 <http://www.w3.org/2004/02/skos/core#example> "PRV-012 has source domains Chain and Link" .


###  https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl#linksProverbA
:linksProverbA rdf:type owl:ObjectProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain :CrossCulturalEquivalence ;
               rdfs:range :Proverb ;
               rdfs:comment "Links a cross-cultural equivalence to the first of the two proverbs it connects; the generated data puts the lower proverb ID here, and the order carries no meaning. Functional: one equivalence link points to exactly one proverb as its 'A' side."@en ;
               rdfs:isDefinedBy <https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl> ;
               rdfs:label "links proverb A"@en ;
               <http://www.w3.org/2004/02/skos/core#example> "Equiv_PRV-012_PRV-025 links proverb A PRV-012" .


###  https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl#linksProverbB
:linksProverbB rdf:type owl:ObjectProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain :CrossCulturalEquivalence ;
               rdfs:range :Proverb ;
               rdfs:comment "Links a cross-cultural equivalence to the second of the two proverbs it connects, which is in a different language from proverb A. Functional: one equivalence link points to exactly one proverb as its 'B' side."@en ;
               rdfs:isDefinedBy <https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl> ;
               rdfs:label "links proverb B"@en ;
               <http://www.w3.org/2004/02/skos/core#example> "Equiv_PRV-012_PRV-025 links proverb B PRV-025" .


###  https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl#usedIn
:usedIn rdf:type owl:ObjectProperty ;
        rdfs:domain :Proverb ;
        rdfs:range :SituationOfUse ;
        rdfs:comment "Links a proverb to a situation in which it is typically used."@en ;
        rdfs:isDefinedBy <https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl> ;
        rdfs:label "used in"@en ;
        <http://www.w3.org/2004/02/skos/core#example> "PRV-012 used in Situation_PRV-012" .


#################################################################
#    Data properties
#################################################################

###  https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl#annotatedBy
:annotatedBy rdf:type owl:DatatypeProperty ;
             rdfs:domain :CrossCulturalEquivalence ;
             rdfs:range xsd:string ;
             rdfs:comment "The name of the person who reviewed and classified an equivalence link."@en ;
             rdfs:isDefinedBy <https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl> ;
             rdfs:label "annotated by"@en .


###  https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl#hasDivergenceNote
:hasDivergenceNote rdf:type owl:DatatypeProperty ;
                   rdfs:domain :CrossCulturalEquivalence ;
                   rdfs:range xsd:string ;
                   rdfs:comment "A free-text note on how the two linked proverbs differ, in imagery, tone or use."@en ;
                   rdfs:isDefinedBy <https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl> ;
                   rdfs:label "has divergence note"@en ;
                   <http://www.w3.org/2004/02/skos/core#example> "Auto-derived: shared tacit lesson 'Actions over intentions'; source domains differ (Hell, Road vs Bear)." .


###  https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl#hasLabel
:hasLabel rdf:type owl:DatatypeProperty ;
          rdfs:domain :TacitLesson ;
          rdfs:range xsd:string ;
          rdfs:comment "The human-readable name of a tacit lesson."@en ;
          rdfs:isDefinedBy <https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl> ;
          rdfs:label "has label"@en ;
          <http://www.w3.org/2004/02/skos/core#example> "Group vulnerability" .


###  https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl#hasLanguage
:hasLanguage rdf:type owl:DatatypeProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain :Proverb ;
             rdfs:range xsd:string ;
             rdfs:comment "The language of the proverb's original text, as an ISO 639-1 code. Functional: one proverb individual is recorded in exactly one language."@en ;
             rdfs:isDefinedBy <https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl> ;
             rdfs:label "has language"@en ;
             <http://www.w3.org/2004/02/skos/core#example> "en" ,
                                                           "fa" ,
                                                           "it" ,
                                                           "sq" .


###  https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl#hasProverbID
:hasProverbID rdf:type owl:DatatypeProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :Proverb ;
              rdfs:range xsd:string ;
              rdfs:comment "Stable human-readable ID from the shared spreadsheet, e.g. PRV-001. Used as a key when generating URIs. Functional: one proverb has exactly one ID."@en ;
              rdfs:isDefinedBy <https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl> ;
              rdfs:label "has proverb ID"@en ;
              <http://www.w3.org/2004/02/skos/core#example> "PRV-001" .


###  https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl#hasText
:hasText rdf:type owl:DatatypeProperty ,
                  owl:FunctionalProperty ;
         rdfs:domain :Proverb ;
         rdfs:range xsd:string ;
         rdfs:comment "The proverb as written in its original language and script. Functional: one proverb has exactly one literal text."@en ;
         rdfs:isDefinedBy <https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl> ;
         rdfs:label "has text"@en ;
         <http://www.w3.org/2004/02/skos/core#example> "PRV-020 has text 'Chi cerca, trova.'" .


###  https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl#hasTranslation
:hasTranslation rdf:type owl:DatatypeProperty ;
                rdfs:domain :Proverb ;
                rdfs:range xsd:string ;
                rdfs:comment "Word-for-word English gloss, distinct from hasText (the proverb in its original language)."@en ;
                rdfs:isDefinedBy <https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl> ;
                rdfs:label "has literal English translation"@en ;
                <http://www.w3.org/2004/02/skos/core#example> "PRV-020 has translation 'Those who search, find.'" .


#################################################################
#    Classes
#################################################################

###  https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl#CrossCulturalEquivalence
:CrossCulturalEquivalence rdf:type owl:Class ;
                          rdfs:subClassOf [ rdf:type owl:Restriction ;
                                            owl:onProperty :hasEquivalenceType ;
                                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass :EquivalenceType
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty :linksProverbA ;
                                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass :Proverb
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty :linksProverbB ;
                                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass :Proverb
                                          ] ;
                          rdfs:comment "A reified link between two proverbs that share a TacitLesson but diverge (or don't) in imagery. Modeled as a full class so the equivalence itself can carry attributes (type, divergence notes, annotator)."@en ;
                          rdfs:isDefinedBy <https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl> ;
                          rdfs:label "Cross-Cultural Equivalence"@en ;
                          <http://www.w3.org/2004/02/skos/core#example> "Equiv_PRV-012_PRV-025: the English and Italian chain proverbs, a DirectMatch" .


###  https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl#EquivalenceType
:EquivalenceType rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Class ;
                                       owl:oneOf ( :DirectMatch
                                                   :FalseFriend
                                                   :PartialOverlap
                                                   :SameLessonDifferentImage
                                                 )
                                     ] ;
                 rdfs:comment "A controlled vocabulary for how two linked proverbs relate, based on whether they share a lesson and whether they share an image: DirectMatch, SameLessonDifferentImage, PartialOverlap or FalseFriend."@en ;
                 rdfs:isDefinedBy <https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl> ;
                 rdfs:label "Equivalence Type"@en .


###  https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl#Proverb
:Proverb rdf:type owl:Class ;
         rdfs:subClassOf [ rdf:type owl:Restriction ;
                           owl:onProperty :hasSourceDomain ;
                           owl:someValuesFrom :SourceDomain
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :usedIn ;
                           owl:someValuesFrom :SituationOfUse
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :hasLesson ;
                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onClass :TacitLesson
                         ] ;
         rdfs:comment "The surface expression of a proverb: its literal text, language, and image/source domain."@en ;
         rdfs:isDefinedBy <https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl> ;
         rdfs:label "Proverb"@en ;
         <http://www.w3.org/2004/02/skos/core#example> "PRV-012: 'A chain is only as strong as its weakest link.' (en)" .


###  https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl#SituationOfUse
:SituationOfUse rdf:type owl:Class ;
                rdfs:comment "The pragmatic context in which a proverb is deployed: what the speaker uses it to do, such as warn, comfort or encourage."@en ;
                rdfs:isDefinedBy <https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl> ;
                rdfs:label "Situation of Use"@en ;
                <http://www.w3.org/2004/02/skos/core#example> "Situation_PRV-012: 'Used to show how the strength of a group depends on every individual's ability'" .


###  https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl#SourceDomain
:SourceDomain rdf:type owl:Class ;
              rdfs:comment "The literal imagery/domain a proverb draws on (e.g. birds, fish, sleep, food)."@en ;
              rdfs:isDefinedBy <https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl> ;
              rdfs:label "Source Domain"@en ;
              <http://www.w3.org/2004/02/skos/core#example> "Chain, Water, Bear" .


###  https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl#TacitLesson
:TacitLesson rdf:type owl:Class ;
             rdfs:comment "The unspoken, language-independent moral a proverb conveys; proverbs from different languages can share the same lesson."@en ;
             rdfs:isDefinedBy <https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl> ;
             rdfs:label "Tacit Lesson"@en ;
             <http://www.w3.org/2004/02/skos/core#example> "GroupVulnerability, labelled 'Group vulnerability'" .


#################################################################
#    Individuals
#################################################################

###  https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl#DirectMatch
:DirectMatch rdf:type owl:NamedIndividual ,
                      :EquivalenceType ;
             rdfs:comment "The two proverbs share both the tacit lesson and the core image (the same scene or object), even if their source-domain tags are worded differently."@en ;
             rdfs:isDefinedBy <https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl> ;
             rdfs:label "Direct match (same lesson AND same source domain)"@en ;
             <http://www.w3.org/2004/02/skos/core#example> "Equiv_PRV-020_PRV-029: 'Chi cerca, trova' (it) and 'Kush kërkon, gjen' (sq), both 'who seeks, finds'" .


###  https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl#FalseFriend
:FalseFriend rdf:type owl:NamedIndividual ,
                      :EquivalenceType ;
             rdfs:comment "The two proverbs share an image but teach different lessons."@en ;
             rdfs:isDefinedBy <https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl> ;
             rdfs:label "False friend (same image, different lesson)"@en ;
             <http://www.w3.org/2004/02/skos/core#example> "PRV-003 'Every cloud has a silver lining' (en) and PRV-027 'A word without a deed is like a cloud without rain' (sq): the same cloud, optimism versus empty words" .


###  https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl#PartialOverlap
:PartialOverlap rdf:type owl:NamedIndividual ,
                         :EquivalenceType ;
                rdfs:comment "Same lesson; the images share an element or scene type without being the same image."@en ;
                rdfs:isDefinedBy <https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl> ;
                rdfs:label "Partial overlap"@en ;
                <http://www.w3.org/2004/02/skos/core#example> "Equiv_PRV-004_PRV-016: the end of the night (fa) and the end of the storm (it), the same sequence with different scenery" .


###  https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl#SameLessonDifferentImage
:SameLessonDifferentImage rdf:type owl:NamedIndividual ,
                                   :EquivalenceType ;
                          rdfs:comment "The two proverbs share a tacit lesson but no element of their imagery."@en ;
                          rdfs:isDefinedBy <https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl> ;
                          rdfs:label "Same lesson, different image"@en ;
                          <http://www.w3.org/2004/02/skos/core#example> "Equiv_PRV-012_PRV-013: a chain (en) and a wall (fa) that both fail at their weakest point" .


#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :CrossCulturalEquivalence
                :EquivalenceType
                :Proverb
                :SituationOfUse
                :SourceDomain
                :TacitLesson
              )
] .


[ rdf:type owl:AllDifferent ;
  owl:distinctMembers ( :DirectMatch
                        :FalseFriend
                        :PartialOverlap
                        :SameLessonDifferentImage
                      )
] .


###  Generated by the OWL API (version 5.1.18) https://github.com/owlcs/owlapi/
