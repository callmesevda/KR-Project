:PRV-009 a :Proverb,
        owl:NamedIndividual ;
    :hasLanguage "fa" ;
    :hasLesson :HiddenDepthsDeceptiveAppearances ;
    :hasProverbID "PRV-009" ;
    :hasSourceDomain :Noise,
        :Posture ;
