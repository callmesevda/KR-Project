    :hasLesson :HiddenDepthsDeceptiveAppearances ;
    :hasProverbID "PRV-008" ;
    :hasSourceDomain :Depth,
        :Water ;
    :hasText "Still waters run deep." ;
    :hasTranslation "Still waters run deep." ;
