<https://raw.githubusercontent.com/callmesevda/KR-Project/main/test/text_kg.ttl> a owl:Ontology ;
    rdfs:label "PROTO text knowledge graph (test of point 6)"@en ;
    dcterms:created "2026-10-07"^^xsd:date ;
    dcterms:creator "Polyxeni Chasanai" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    rdfs:comment "Proverbs found in nine real texts (news, opinion, blogs, a forum and a social-media post in English, Albanian, Italian and Persian), described with PROTO and the proposed text-usage extension."@en ;
    owl:imports <https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto-ontology-structure.ttl>,
        <https://raw.githubusercontent.com/callmesevda/KR-Project/main/proto_data.ttl>,
        <https://raw.githubusercontent.com/callmesevda/KR-Project/main/test/proto-text-extension.ttl> .

:Equiv_PRV-031_PRV-101 a owl:NamedIndividual,
        proto:CrossCulturalEquivalence ;
    proto:annotatedBy "Polyxeni Chasanai" ;
    proto:hasDivergenceNote "Added from the text test. Same lesson as the Albanian 'Një dele e zgjebosur prish gjithë tufën' (one bad member spoils the group), different image (apple vs sheep). In current English usage the short form 'a few bad apples' reverses the lesson; see occurrences Occ_T1_1 and Occ_T2_1." ;
    proto:hasEquivalenceType proto:SameLessonDifferentImage ;
    proto:linksProverbA kg:PRV-031 ;
    proto:linksProverbB :PRV-101 .

:Occ_T1_1 a owl:NamedIndividual,
        pext:ProverbOccurrence ;
    rdfs:comment "The original proverb ('one bad apple spoils the barrel') warns that one member corrupts the whole group. Here it is used to say the opposite: the group is fine, only a few members are bad."@en ;
    pext:appliedTo :Target_PoliceOfficers ;
    pext:hasMeaningShift true ;
    pext:hasStance pext:Minimising ;
    pext:inSituation :Situation_T1_1 ;
    pext:occurrenceOf :PRV-101 ;
    pext:occursIn :T1 ;
    pext:quote "So before the idea was that even one bad apple was enough to taint the whole group, and now the idea is, well, you can discount the bad apple because it's not representative of the entire group. National security adviser Robert O'Brien stated the issue was a result of a few bad apples, not systemic racism."@en ;
    pext:speaker "Robert O'Brien (US National Security Adviser), reported by ABC News" .

:Occ_T2_1 a owl:NamedIndividual,
        pext:ProverbOccurrence ;
    rdfs:comment "Meta-use: the text does not apply the proverb, it analyses how others apply it."@en ;
    pext:appliedTo :Target_PoliceOfficers ;
    pext:hasMeaningShift true ;
    pext:hasStance pext:Critical ;
    pext:inSituation :Situation_T2_1 ;
    pext:occurrenceOf :PRV-101 ;
    pext:occursIn :T2 ;
    pext:quote "The 'bad apples' narrative has been ascendant since the shift from the institutionalized and explicit racism of the pre-civil rights era to more subtle forms of racism today."@en ;
    pext:speaker "Academic author, The Conversation" .

:Occ_T3_1 a owl:NamedIndividual,
        pext:ProverbOccurrence ;
    rdfs:comment "Commercial use. Frames individual employees as the risk; matches the 'weakest point' sub-lesson."@en ;
    pext:appliedTo :Target_Employees ;
    pext:hasMeaningShift false ;
    pext:hasStance pext:Warning ;
    pext:inSituation :Situation_T3_1 ;
    pext:occurrenceOf kg:PRV-012 ;
    pext:occursIn :T3 ;
    pext:quote "You've heard the phrase 'a chain is only as strong as its weakest link'? This is especially apt when it comes to securing your business against cyber threats."@en ;
    pext:speaker "Company blog (cybersecurity vendor)" .

:Occ_T4_1 a owl:NamedIndividual,
        pext:ProverbOccurrence ;
    rdfs:comment "Positive reading, consistent with the Situation of Use already recorded for PRV-008."@en ;
    pext:appliedTo :Target_IntrovertsAtWork ;
    pext:hasMeaningShift false ;
    pext:hasStance pext:Positive ;
    pext:inSituation :Situation_T4_1 ;
    pext:occurrenceOf kg:PRV-008 ;
    pext:occursIn :T4 ;
    pext:quote "Still waters run deep - Never underestimate an introvert. Introverts prefer working alone or in small groups and introverts generally spend time thinking and reflecting before 'doing'."@en ;
    pext:speaker "HR blog author" .

:Occ_T5_1 a owl:NamedIndividual,
        pext:ProverbOccurrence ;
    rdfs:comment "Direct evidence for finding 3 of the cross-cultural review: the English proverb is not only positive. Its use overlaps with the Albanian 'Uji i qetë të mbyt' (warning)."@en ;
    pext:appliedTo :Target_QuietPeople ;
    pext:hasMeaningShift false ;
    pext:hasStance pext:Ambiguous ;
    pext:inSituation :Situation_T5_1 ;
    pext:occurrenceOf kg:PRV-008 ;
    pext:occursIn :T5 ;
    pext:quote "Alxmrphi: It means something that might not be big and attractive on the surface, can have a very deep person, I've heard this used about people. Josh_: Water, such as in a river or on beach, can be deceptive. Thomas Tompion: Still waters run deep - 10 uses - 5 negative, 2 positive, 3 hard to tell."@en ;
    pext:speaker "Forum users (native and non-native speakers)" .

:Occ_T6_1 a owl:NamedIndividual,
        pext:ProverbOccurrence ;
    rdfs:comment "Standard use of the sow/reap lesson."@en ;
    pext:appliedTo :Target_PoliticiansInPower ;
    pext:hasMeaningShift false ;
    pext:hasStance pext:Warning ;
    pext:inSituation :Situation_T6_1 ;
    pext:occurrenceOf kg:PRV-033 ;
    pext:occursIn :T6 ;
    pext:quote "Historia e të fortëve në politikë, ose çfarë të mbjellësh, do korrësh. Sipas Ramës, ai ka mbjellë reforma sot për të korrur sukses nesër, ose më sactë, më 2017."@sq ;
    pext:speaker "Gjergj Erebara (journalist), in the title" .

:Occ_T6_2 a owl:NamedIndividual,
        pext:ProverbOccurrence ;
    rdfs:comment "Same text, same proverb, opposite stance: the image of sowing is turned from a warning into a promise of reward."@en ;
    pext:appliedTo :Target_HisOwnGovernmentSReforms ;
    pext:hasMeaningShift true ;
    pext:hasStance pext:Promise ;
    pext:inSituation :Situation_T6_2 ;
    pext:occurrenceOf kg:PRV-033 ;
    pext:occursIn :T6 ;
    pext:quote "Historia e të fortëve në politikë, ose çfarë të mbjellësh, do korrësh. Sipas Ramës, ai ka mbjellë reforma sot për të korrur sukses nesër, ose më sactë, më 2017."@sq ;
    pext:speaker "Edi Rama (Prime Minister), paraphrased by the journalist" .

:Occ_T7_1 a owl:NamedIndividual,
        pext:ProverbOccurrence ;
    rdfs:comment "Social-media use. The target is implicit: the reader must infer who is 'sowing wind'. The proverb lets the speaker accuse without naming anyone."@en ;
    pext:appliedTo :Target_EuropeanGovernmentsMigrationPolicy ;
    pext:hasMeaningShift false ;
    pext:hasStance pext:Warning ;
    pext:inSituation :Situation_T7_1 ;
    pext:occurrenceOf kg:PRV-023 ;
    pext:occursIn :T7 ;
    pext:quote "A margine della crisi europea sui migranti, Avviso ai Naviganti, basato solo sull'esperienza: attenzione! Chi semina vento raccoglie tempesta"@it ;
    pext:speaker "Pier Ferdinando Casini (Italian politician), on Instagram" .

:Occ_T8_1 a owl:NamedIndividual,
        pext:ProverbOccurrence ;
    rdfs:comment "First of two applications in the same editorial (the text also applies it to climate change)."@en ;
    pext:appliedTo :Target_PoliticiansWhoHandOutImproperFavours ;
    pext:hasMeaningShift false ;
    pext:hasStance pext:Warning ;
    pext:inSituation :Situation_T8_1 ;
    pext:occurrenceOf kg:PRV-023 ;
    pext:occursIn :T8 ;
    pext:quote "Chi semina vento, raccoglie tempesta."@it ;
    pext:speaker "Newspaper editor" .

:Occ_T8_2 a owl:NamedIndividual,
        pext:ProverbOccurrence ;
    rdfs:comment "Second application in the same text: one text, two targets, two occurrences."@en ;
    pext:appliedTo :Target_CitizensWhoStopThinkingForThemselves ;
    pext:hasMeaningShift false ;
    pext:hasStance pext:Warning ;
    pext:inSituation :Situation_T8_2 ;
    pext:occurrenceOf kg:PRV-023 ;
    pext:occursIn :T8 ;
    pext:quote "Chi semina vento, raccoglie tempesta."@it ;
    pext:speaker "Newspaper editor" .

:Occ_T9_1 a owl:NamedIndividual,
        pext:ProverbOccurrence ;
    rdfs:comment "Confirms the 'foolish friend does harm' reading of PRV-002 from the review (not 'good intentions without action'). Date given only in the Iranian calendar (year 1391 SH, about 2012-13). Translation to be checked by Saba."@en ;
    pext:appliedTo :Target_WellMeaningFriends ;
    pext:hasMeaningShift false ;
    pext:hasStance pext:Warning ;
    pext:inSituation :Situation_T9_1 ;
    pext:occurrenceOf kg:PRV-002 ;
    pext:occursIn :T9 ;
    pext:quote "هر کس که بخواهد از روی دوستی کاری برای کسی انجام بدهد که به ضرر او تمام می شود می گویند فلانی دوستی خاله خرسه می کند."@fa ;
    pext:speaker "Personal blogger" .

kg:PRV-002 proto:usedIn :Situation_T9_1 .

kg:PRV-012 proto:usedIn :Situation_T3_1 .

