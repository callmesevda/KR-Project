:PRV-101 a owl:NamedIndividual,
        proto:Proverb ;
    rdfs:comment "Modern shortened form of 'One bad apple spoils the (whole) barrel'. Found in texts T1 and T2, where it is used with the opposite meaning (only a few members are bad, the group is fine)."@en ;
    proto:hasLanguage "en" ;
    proto:hasLesson kg:GroupVulnerability ;
    proto:hasProverbID "PRV-101" ;
    proto:hasSourceDomain :Apple ;
    proto:hasText "A few bad apples." ;
    proto:hasTranslation "A few bad apples." ;
    proto:usedIn :Situation_T1_1,
        :Situation_T2_1 .

